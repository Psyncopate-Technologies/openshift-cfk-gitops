# =============================================================================
# ROSA Cluster Configuration
# Copy this file to terraform.tfvars and fill in your values
# =============================================================================

# Cluster name (must be lowercase, start with letter)
cluster_name = "cfk-test"

# OpenShift version
openshift_version = "4.14.0"

# AWS region
aws_region = "us-east-1"

# =============================================================================
# Compute Configuration
# =============================================================================

# Instance type for worker nodes
compute_machine_type = "m5.xlarge"

# Number of worker nodes
compute_nodes = 2

# Multi-AZ deployment (increases cost but provides HA)
multi_az = false

# =============================================================================
# Network Configuration
# =============================================================================

machine_cidr = "10.0.0.0/16"
service_cidr = "172.30.0.0/16"
pod_cidr     = "10.128.0.0/14"
host_prefix  = 23

# =============================================================================
# Authentication
# =============================================================================

# Red Hat Cloud Services authentication — service-account credentials.
# Create at https://console.redhat.com/iam/service-accounts and set:
#   rhcs_client_id     = "..."
#   rhcs_client_secret = "..."
# or via env vars TF_VAR_rhcs_client_id / TF_VAR_rhcs_client_secret.
# (Offline tokens are deprecated by Red Hat and no longer supported here.)

# Create admin user
create_admin_user = true

# Admin password (leave empty to auto-generate)
# admin_password = ""

# =============================================================================
# Tags
# =============================================================================

tags = {
  Project     = "confluent-platform"
  ManagedBy   = "terraform"
  Environment = "dev"
  Owner       = "your-name"
}
